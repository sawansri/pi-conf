#!/usr/bin/env bash
# Install the C/C++ analysis tools multi-review uses, without root, into a
# venv at ${MR_TOOLS_HOME:-~/.local/share/multi-review}/venv (PyPI wheels):
#   clang-tidy  bug-finding checks on changed lines (mr-cxx-check)
#   lizard      complexity of the functions a change touches (mr-cxx-check)
#   clangd      the reviewers' xref tool; its index lives next to the venv
# Re-running upgrades them.
set -euo pipefail

home="${MR_TOOLS_HOME:-$HOME/.local/share/multi-review}"
mkdir -p "$home"
python3 -m venv "$home/venv"
"$home/venv/bin/pip" install -q --upgrade pip clang-tidy lizard clangd
"$home/venv/bin/clang-tidy" --version | grep -i version
"$home/venv/bin/clangd" --version | head -1
echo "lizard $("$home/venv/bin/lizard" --version)"
echo "installed into $home/venv"
