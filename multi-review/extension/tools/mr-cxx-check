#!/usr/bin/env python3
"""Static checks on changed C/C++ files, for multi-review's sandbox.

    mr-cxx-check [-p BUILD_DIR] [--diff FILE] FILE...

Recompiles each changed source with its own flags from compile_commands.json
plus -fsyntax-only -Wall -Wextra and a few low-noise bug-finding warnings
(no build system involved, so no CMake re-configure and no network),
compiles a few includers of each changed header, and runs clang-tidy and
cppcheck on the changed sources when they are installed (install-cxx-analysis
puts clang-tidy in ~/.local/share/multi-review/venv).

For every function the diff touches, lizard reports cyclomatic complexity,
size and parameter count before -> after, flagging functions over the
thresholds or whose complexity jumped (informational: it never fails the
check).

Warnings are kept only on changed lines: the lines the unified diff in
--diff (or $MR_CXX_DIFF) adds or touches, or, without one, `git diff HEAD`.
A file the diff doesn't cover is checked whole. Errors are kept wherever
they are. Exit status 1 when anything was reported.

PR worktrees have no build directory of their own: MR_CXX_DB points at the
main checkout's compile_commands.json and MR_CXX_REMAP=FROM=TO rewrites its
source paths onto the worktree (paths inside the build directory stay put).
"""
import argparse
import concurrent.futures
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

SOURCE_EXT = (".c", ".cc", ".cpp", ".cxx", ".c++")
HEADER_EXT = (".h", ".hh", ".hpp", ".hxx", ".h++", ".inl", ".ipp")
INCLUDERS_PER_HEADER = 3
# Beyond -Wall -Wextra: front-end warnings that find real bugs with little
# noise. (-Wnull-dereference and friends need the optimizer; useless here.)
EXTRA_WARNINGS = ["-Wduplicated-cond", "-Wduplicated-branches", "-Wlogical-op", "-Wshadow=local"]
TU_TIMEOUT_SEC = 120
CONTEXT = re.compile(r"^(In file included from |\s+from |[^:\s][^:]*: (In|At) )")
DIAG = re.compile(r"^(?P<path>[^:\s][^:]*):(?P<line>\d+):(?:\d+:)? (?P<kind>error|warning|fatal error): ")


def find_db(root, build_dir):
    if build_dir:
        return os.path.join(os.path.abspath(build_dir), "compile_commands.json")
    if os.environ.get("MR_CXX_DB"):
        return os.environ["MR_CXX_DB"]
    candidates = [os.path.join(root, "compile_commands.json")]
    candidates += sorted(glob.glob(os.path.join(root, "build*", "compile_commands.json")))
    candidates += sorted(glob.glob(os.path.join(root, "out", "*", "compile_commands.json")))
    candidates += sorted(glob.glob(os.path.join(root, "build*", "*", "compile_commands.json")))
    return next((c for c in candidates if os.path.isfile(c)), None)


def remapper(db_path):
    spec = os.environ.get("MR_CXX_REMAP", "")
    if "=" not in spec:
        return lambda p: p
    src, dst = spec.split("=", 1)
    src, dst = src.rstrip("/"), dst.rstrip("/")
    build = os.path.dirname(db_path)

    def remap(text):
        # Token-wise, so -I/main/src becomes -I/worktree/src but /main/build/... stays.
        def one(tok):
            for prefix in ("", "-I", "-isystem", "-iquote", "-include"):
                if tok.startswith(prefix + src) and not tok.startswith(prefix + build):
                    rest = tok[len(prefix) + len(src):]
                    if rest == "" or rest.startswith("/"):
                        return prefix + dst + rest
            return tok
        return one(text)

    return remap


PATH_FLAGS = ("-I", "-isystem", "-iquote", "-idirafter", "-include")


def absolutize(args, directory):
    """Include paths made absolute, so a remap can move them onto the worktree."""
    out, take_next = [], False
    for a in args:
        if take_next:
            out.append(os.path.normpath(os.path.join(directory, a)))
            take_next = False
            continue
        if a in PATH_FLAGS:
            take_next = True
            out.append(a)
            continue
        flag = next((f for f in PATH_FLAGS if a.startswith(f) and len(a) > len(f)), None)
        out.append(flag + os.path.normpath(os.path.join(directory, a[len(flag):])) if flag else a)
    return out


def load_entries(db_path):
    remap = remapper(db_path)
    entries = []
    for e in json.load(open(db_path)):
        args = e.get("arguments") or shlex.split(e["command"])
        directory = e["directory"]
        file = os.path.normpath(os.path.join(directory, e["file"]))
        # The source argument is often relative to the build directory; pin it so the remap moves it too.
        args = [file if not a.startswith("-") and os.path.normpath(os.path.join(directory, a)) == file else a for a in args]
        entries.append({"directory": directory, "file": remap(file), "args": [remap(a) for a in absolutize(args, directory)]})
    return entries


def remapped_db(entries, db_path):
    """compile_commands.json with the remapped paths, for cppcheck and clang-tidy; the original when nothing moved."""
    if "=" not in os.environ.get("MR_CXX_REMAP", ""):
        return db_path
    out = os.path.join(tempfile.mkdtemp(prefix="mr-cxx-db-"), "compile_commands.json")
    with open(out, "w") as f:
        json.dump([{"directory": e["directory"], "file": e["file"], "arguments": e["args"]} for e in entries], f)
    return out


def syntax_command(args):
    """The TU's own compile command minus its outputs (object, depfile), checking syntax only."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        if a in ("-o", "-MF", "-MT", "-MQ"):
            i += 2
            continue
        if a in ("-c", "-MD", "-MMD") or any(a.startswith(p) and len(a) > len(p) for p in ("-o", "-MF", "-MT", "-MQ")):
            i += 1
            continue
        out.append(a)
        i += 1
    gcc = os.path.basename(out[0]) if out else ""
    # gcc-only flags; clang-based drivers would reject them.
    extra = EXTRA_WARNINGS if "clang" not in gcc else ["-Wshadow"]
    return out + ["-fsyntax-only", "-Wall", "-Wextra", *extra, "-fdiagnostics-color=never"]


def compile_tu(entry):
    try:
        r = subprocess.run(syntax_command(entry["args"]), cwd=entry["directory"], capture_output=True, text=True, timeout=TU_TIMEOUT_SEC)
        return entry, r.returncode, r.stderr
    except subprocess.TimeoutExpired:
        return entry, None, f"timed out after {TU_TIMEOUT_SEC}s"
    except OSError as err:
        return entry, None, str(err)


def parse_diff(text, top):
    """{absolute path: set of new-side line numbers the diff adds or deletes next to}."""
    lines, path, new = {}, None, 0
    for l in text.splitlines():
        if l.startswith("+++ "):
            p = l[4:].split("\t")[0]
            path = None if p == "/dev/null" else os.path.normpath(os.path.join(top, p[2:] if p.startswith("b/") else p))
            if path:
                lines.setdefault(path, set())
        elif l.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", l)
            new = int(m.group(1)) if m else 0
        elif path is None or l.startswith(("--- ", "diff ", "index ")):
            continue
        elif l.startswith("+"):
            lines[path].add(new)
            new += 1
        elif l.startswith("-"):
            # A deletion touches the lines on either side of where it was.
            lines[path].update({max(new - 1, 1), new})
        elif l.startswith(" "):
            new += 1
    return lines


def diff_text(top, files):
    """The diff to filter by: --diff/$MR_CXX_DIFF, else the working tree against HEAD."""
    path = os.environ.get("MR_CXX_DIFF")
    if path and os.path.isfile(path):
        return open(path, errors="replace").read()
    r = subprocess.run(["git", "diff", "HEAD", "--", *files], cwd=top, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def old_source(path, new_text, diff, top):
    """The file before the diff, by applying its hunks in reverse; None if they don't match the file."""
    hunks, cur, in_file = [], None, False
    for l in diff.splitlines():
        if l.startswith("+++ "):
            p = l[4:].split("\t")[0]
            in_file = p != "/dev/null" and os.path.normpath(os.path.join(top, p[2:] if p.startswith("b/") else p)) == path
            cur = None
        elif not in_file or l.startswith(("--- ", "diff ", "index ")):
            continue
        elif l.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))?", l)
            cur = {"start": int(m.group(1)), "new": [], "old": []}
            hunks.append(cur)
        elif cur is not None and l[:1] in ("+", "-", " ", ""):
            text = l[1:]
            if l[:1] != "-":
                cur["new"].append(text)
            if l[:1] != "+":
                cur["old"].append(text)
    if not hunks:
        return None
    lines = new_text.split("\n")
    for h in reversed(hunks):
        # A hunk adding nothing (pure deletion) is anchored after its start line.
        at = h["start"] if not h["new"] else h["start"] - 1
        if lines[at:at + len(h["new"])] != h["new"]:
            return None
        lines[at:at + len(h["new"])] = h["old"]
    return "\n".join(lines)


# A touched function is flagged above these, or when its complexity rose by CCN_JUMP.
CCN_MAX, PARAMS_MAX, NLOC_MAX, CCN_JUMP = 15, 6, 100, 5


def complexity_report(changed, lines, diff, top, root):
    """Before -> after metrics for the functions the diff touches; None when lizard is missing."""
    try:
        import lizard
    except ImportError:
        return None
    rows = []
    for path in sorted(changed):
        touched = lines.get(path)
        if not touched or not os.path.exists(path):
            continue
        new_text = open(path, errors="replace").read()
        after = lizard.analyze_file.analyze_source_code(path, new_text).function_list
        old_text = old_source(path, new_text, diff, top)
        before = {f.long_name: f for f in lizard.analyze_file.analyze_source_code(path, old_text).function_list} if old_text is not None else {}
        for f in after:
            if not any(f.start_line <= n <= f.end_line for n in touched):
                continue
            b = before.get(f.long_name)
            flags = []
            if f.cyclomatic_complexity > CCN_MAX:
                flags.append(f"CCN>{CCN_MAX}")
            if f.parameter_count > PARAMS_MAX:
                flags.append(f"params>{PARAMS_MAX}")
            if f.nloc > NLOC_MAX:
                flags.append(f"NLOC>{NLOC_MAX}")
            if b and f.cyclomatic_complexity - b.cyclomatic_complexity >= CCN_JUMP:
                flags.append(f"CCN +{f.cyclomatic_complexity - b.cyclomatic_complexity}")
            arrow = lambda old, new: f"{old}->{new}" if b is not None and old != new else str(new)
            metrics = (f"CCN {arrow(b and b.cyclomatic_complexity, f.cyclomatic_complexity)}, "
                       f"NLOC {arrow(b and b.nloc, f.nloc)}, params {arrow(b and b.parameter_count, f.parameter_count)}")
            status = "new" if old_text is not None and b is None else ""
            rows.append((bool(flags), f.cyclomatic_complexity,
                         f"{'!' if flags else ' '} {os.path.relpath(path, root)}:{f.start_line} {f.name}: {metrics}"
                         + (f" ({status})" if status else "") + (f"  [{', '.join(flags)}]" if flags else "")))
    rows.sort(key=lambda r: (not r[0], -r[1]))
    return [r[2] for r in rows], sum(1 for r in rows if r[0])


def on_changed_line(path, line, changed, lines):
    """In a changed file and, when the diff covers that file, on a line it touched."""
    if path not in changed:
        return False
    touched = lines.get(path)
    return touched is None or line in touched


def keep_diagnostics(stderr, directory, changed, lines, warnings_only=False):
    """Diagnostic blocks (first line plus its notes/context) on changed lines, plus every error."""
    kept, block, keep, context = [], [], False, []
    for line in stderr.splitlines():
        m = DIAG.match(line)
        if m:
            if keep:
                kept.extend(block)
            path = os.path.normpath(os.path.join(directory, m.group("path")))
            is_error = "error" in m.group("kind")
            keep = (is_error and not warnings_only) or (not is_error and on_changed_line(path, int(m.group("line")), changed, lines))
            # "In file included from" / "In function" lines precede the diagnostic they belong to.
            block, context = context + [line], []
        elif CONTEXT.match(line):
            context.append(line)
        else:
            block.append(line)
    if keep:
        kept.extend(block)
    return kept


def includers(header, entries, limit):
    """TUs that include `header`: the #include path must be a path suffix of it, not just the same basename."""
    name = os.path.basename(header)
    pattern = re.compile(r'^\s*#\s*include\s*[<"]([^>"]*\b' + re.escape(name) + r')[>"]', re.M)
    found = []
    for e in entries:
        try:
            text = open(e["file"], errors="replace").read()
        except OSError:
            continue
        for inc in pattern.findall(text):
            inc = os.path.normpath(inc)
            if header.endswith(os.sep + inc) or os.path.normpath(os.path.join(os.path.dirname(e["file"]), inc)) == header:
                found.append(e)
                break
        if len(found) >= limit:
            break
    return found


def run_cppcheck(sources, db_path, changed, lines):
    if not shutil.which("cppcheck") or not sources:
        return None
    found, unchecked = [], []
    for src in sources:
        r = subprocess.run(
            ["cppcheck", f"--project={db_path}", f"--file-filter={src}", "--enable=warning,performance,portability",
             "--inline-suppr", "--quiet", "--template={file}:{line}: {severity}: {message} [{id}]"],
            capture_output=True, text=True, timeout=TU_TIMEOUT_SEC,
        )
        out = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()]
        # Never let "matched nothing" read as "clean".
        if any("could not find any files matching" in l for l in out):
            unchecked.append(src)
            continue
        found += out
    # Like the compiler output: only what lands in changed files, once each
    # (every includer of a header repeats its issues).
    kept = []
    for l in found:
        m = re.match(r"^([^:]+):(\d+):", l)
        if m and on_changed_line(os.path.normpath(m.group(1)), int(m.group(2)), changed, lines) and l not in kept:
            kept.append(l)
    return kept, unchecked


# Bug-finding checks with a low false-positive rate on real code, named
# explicitly (wildcards pull in style checks). clang-analyzer-* is left out:
# 5-10x the time per file and, on lemonade, no extra findings.
TIDY_CHECKS = ",".join([
    "-*",
    "bugprone-*",
    "-bugprone-easily-swappable-parameters",
    "-bugprone-narrowing-conversions",
    "-bugprone-branch-clone",
    "-bugprone-exception-escape",
    "performance-*",
    "-performance-avoid-endl",
    "-performance-enum-size",
    "concurrency-mt-unsafe",
    "misc-redundant-expression",
    "misc-throw-by-value-catch-by-reference",
    "misc-unconventional-assign-operator",
    "misc-misplaced-const",
    "readability-function-cognitive-complexity",
])
TIDY_CONFIG = "{CheckOptions: {readability-function-cognitive-complexity.Threshold: 25, readability-function-cognitive-complexity.DescribeBasicIncrements: false}}"


def run_clang_tidy(tus, db_path, changed, lines, top):
    """clang-tidy on each TU, reporting only on changed lines (headers included); None when not installed."""
    tidy = shutil.which("clang-tidy")
    if not tidy or not tus:
        return None
    line_filter = []
    for f in sorted(changed):
        touched = lines.get(f)
        if touched is None:
            line_filter.append({"name": f})
        elif touched:
            line_filter.append({"name": f, "lines": [[n, n] for n in sorted(touched)]})
    headers = [f for f in changed if f.endswith(HEADER_EXT)]
    header_filter = "|".join(re.escape(h) for h in headers) or "^$"
    # A repo's own .clang-tidy wins over our list.
    own = os.path.exists(os.path.join(top, ".clang-tidy"))
    base = [tidy, "-p", os.path.dirname(db_path), "--quiet", f"--line-filter={json.dumps(line_filter)}",
            f"--header-filter={header_filter}", "--extra-arg=-Wno-unknown-warning-option"]
    if not own:
        base += [f"--checks={TIDY_CHECKS}", f"--config={TIDY_CONFIG}"]

    def one(entry):
        try:
            r = subprocess.run(base + [entry["file"]], capture_output=True, text=True, timeout=TU_TIMEOUT_SEC)
            return entry, r.stdout
        except subprocess.TimeoutExpired:
            return entry, f"{entry['file']}:1:1: error: clang-tidy timed out after {TU_TIMEOUT_SEC}s"

    kept, parse_errors = [], 0
    with concurrent.futures.ThreadPoolExecutor(min(8, os.cpu_count() or 2)) as pool:
        for entry, out in pool.map(one, tus):
            # Errors here are clang failing on gcc-specific code or flags, not
            # findings; count them so a partial analysis doesn't read as clean.
            parse_errors += sum(1 for l in out.splitlines() if DIAG.match(l) and "error" in DIAG.match(l).group("kind"))
            for l in keep_diagnostics(out, entry["directory"], changed, lines, warnings_only=True):
                if not (DIAG.match(l) and l in kept):
                    kept.append(l)
    return kept, parse_errors, own


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-p", dest="build_dir", help="directory holding compile_commands.json")
    ap.add_argument("--diff", help="unified diff whose added lines are the ones to report on")
    ap.add_argument("files", nargs="+")
    opts = ap.parse_args()
    root = os.getcwd()
    if opts.diff:
        os.environ["MR_CXX_DIFF"] = os.path.abspath(opts.diff)
    changed = {os.path.normpath(os.path.join(root, f)) for f in opts.files}
    changed = {f for f in changed if f.endswith(SOURCE_EXT + HEADER_EXT)}
    if not changed:
        print("mr-cxx-check: no C/C++ files among the arguments")
        return 0
    db_path = find_db(root, opts.build_dir)
    if not db_path or not os.path.isfile(db_path):
        print("mr-cxx-check: no compile_commands.json found (configure with -DCMAKE_EXPORT_COMPILE_COMMANDS=ON, or pass -p BUILD_DIR)")
        return 2
    entries = load_entries(db_path)
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=root, capture_output=True, text=True).stdout.strip() or root
    diff = diff_text(top, sorted(changed))
    lines = parse_diff(diff, top)
    by_file = {e["file"]: e for e in entries}
    tus, notes = {}, []
    for f in sorted(changed):
        if not os.path.exists(f):
            continue
        if f.endswith(SOURCE_EXT):
            if f in by_file:
                tus[f] = by_file[f]
            else:
                notes.append(f"{os.path.relpath(f, root)}: not in compile_commands.json (not built in this configuration)")
        else:
            inc = includers(f, entries, INCLUDERS_PER_HEADER)
            if not inc:
                notes.append(f"{os.path.relpath(f, root)}: no translation unit in compile_commands.json includes it")
            for e in inc:
                tus.setdefault(e["file"], e)
    reported = 0
    workers = min(8, os.cpu_count() or 2)
    with concurrent.futures.ThreadPoolExecutor(workers) as pool:
        for entry, code, stderr in pool.map(compile_tu, tus.values()):
            rel = os.path.relpath(entry["file"], root)
            if code is None:
                print(f"== {rel}: could not compile: {stderr}")
                reported += 1
                continue
            kept = keep_diagnostics(stderr, entry["directory"], changed, lines)
            if code != 0 and not kept:
                kept = stderr.splitlines()[-30:]
            print(f"== {rel}: {'compile errors' if code else 'compiles'}" + (f", {sum(1 for l in kept if DIAG.match(l))} diagnostic(s) on changed lines" if kept else ", clean"))
            if kept:
                print("\n".join(kept))
                reported += 1
    db_for_tools = remapped_db(entries, db_path)
    tidy = run_clang_tidy(list(tus.values()), db_for_tools, changed, lines, top)
    if tidy is None:
        print("== clang-tidy: not installed (run install-cxx-analysis)")
    else:
        found, parse_errors, own = tidy
        warnings = sum(1 for l in found if DIAG.match(l))
        print(f"== clang-tidy{' (repo .clang-tidy)' if own else ''}: {warnings} warning(s) on changed lines"
              + (f"; {parse_errors} clang parse error(s), so some code went unanalyzed" if parse_errors else ""))
        if found:
            print("\n".join(found))
            reported += 1
    cpp = run_cppcheck(sorted(f for f in tus if f in changed), db_for_tools, changed, lines)
    if cpp is None:
        print("== cppcheck: not installed or no changed sources")
    else:
        issues, unchecked = cpp
        print(f"== cppcheck: {len(issues)} issue(s)" + (f"; NOT checked: {', '.join(os.path.relpath(u, root) for u in unchecked)}" if unchecked else ""))
        if issues:
            print("\n".join(issues))
            reported += 1
    cx = complexity_report(changed, lines, diff, top, root)
    if cx is None:
        print("== complexity: lizard not installed (run install-cxx-analysis)")
    elif cx[0]:
        rows, flagged = cx
        print(f"== complexity (lizard) of the {len(rows)} function(s) the diff touches; {flagged} flagged (! = over CCN {CCN_MAX} / params {PARAMS_MAX} / NLOC {NLOC_MAX}, or CCN up {CCN_JUMP}+):")
        print("\n".join(rows[:25]) + (f"\n  …{len(rows) - 25} more" if len(rows) > 25 else ""))
    for n in notes:
        print(f"note: {n}")
    return 1 if reported else 0


if __name__ == "__main__":
    sys.exit(main())
